# Copy to .env and/or export these before running the agent.
# YAML config is the source of truth; these override MQTT connection details.

HOME_ROBOT_MQTT_HOST=localhost
HOME_ROBOT_MQTT_PORT=1883
# HOME_ROBOT_MQTT_USERNAME=
# HOME_ROBOT_MQTT_PASSWORD=
# HOME_ROBOT_ROBOT_ID=home-bot
# HOME_ROBOT_CONFIG=config/robot.yaml
